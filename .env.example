# Backend configuration lives under backend/.env (see backend/.env.example).
# Frontend reads API_BASE_URL via --dart-define at build time;
# no .env file is required at the repo root for normal development.

# --- AI Services (the real key lives in backend/.env) ---
# GEMINI_API_KEY=your_gemini_api_key_here

# --- Infrastructure / S3 (Optional, for prod hosting via Terraform in infra/) ---
# S3_HOST=your_s3_host
# S3_REGION=your_s3_region
# S3_ACCESS_KEY=your_s3_access_key
# S3_SECRET_KEY=your_s3_secret_key
