# --- Supabase Configuration ---
# Your Supabase Project ID (found in project settings)
SUPABASE_PROJECT_ID=your_project_id_here

# Supabase Personal Access Token (for CLI authentication)
# SUPABASE_ACCESS_TOKEN=your_access_token_here

# --- AI Services ---
# Required for the 'generate-suggestions' edge function
GEMINI_API_KEY=your_gemini_api_key_here

# --- Email & Auth (Optional) ---
# SENDGRID_API_KEY=your_sendgrid_key_here
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=your_twilio_token_here
# SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=your_apple_secret_here

# --- Infrastructure / S3 (Optional) ---
# S3_HOST=your_s3_host
# S3_REGION=your_s3_region
# S3_ACCESS_KEY=your_s3_access_key
# S3_SECRET_KEY=your_s3_secret_key
